# Copy with: python scripts/configure_demo.py
# This template is documentation. The helper creates random local credentials.
# Never use confidential information: anyone can choose any profile.
AUTH_MODE=open
NODE_ENV=production
I_UNDERSTAND_OPEN_MODE=false
DATA_MODE=demo
AS_OF=2026-11-22
POSTGRES_DB=nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-local-owner-password
APP_DATABASE_PASSWORD=replace-with-random-local-runtime-password
DATABASE_URL=postgresql+psycopg://nexus_app:replace-with-random-local-runtime-password@db:5432/nexus
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-with-random-local-owner-password@db:5432/nexus
API_BASE_URL=http://api:8000
AI_MODE=deterministic
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional; server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
MINIO_ROOT_USER=nexus-local
MINIO_ROOT_PASSWORD=replace-with-random-local-storage-password
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=nexus-local
MINIO_SECRET_KEY=replace-with-random-local-storage-password
MINIO_BUCKET=nexus-evidence
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_TELEMETRY_DISABLED=1
# UI migration: off uses the existing workspace; on enables the Daylight Atlas screen.
NEXT_PUBLIC_UI_V2=off
# External tiles intentionally disabled. CSP must also permit an opted-in tile origin.
NEXT_PUBLIC_MAP_TILE_URL=
