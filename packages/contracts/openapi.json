  "components": {
    "schemas": {
      "Actor": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "institution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Institution Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "institution_id"
        ],
        "title": "Actor"
      },
      "DirectiveOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "maximum": 23.0,
            "minimum": 1.0,
            "title": "Number"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "full_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Text"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "published",
              "unverified"
            ],
            "title": "Provenance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "provenance"
        ],
        "title": "DirectiveOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProfileOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "institution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Institution Id"
          },
          "institution_name": {
            "type": "string",
            "title": "Institution Name"
          },
          "is_simulated": {
            "type": "boolean",
            "const": true,
            "title": "Is Simulated",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "institution_id",
          "institution_name"
        ],
        "title": "ProfileOut"
      },
      "ReportCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Title"
          },
          "period": {
            "type": "string",
            "pattern": "^FY20\\d{2}/\\d{2} Q[1-4]$",
            "title": "Period"
          },
          "narrative": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Narrative"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "period",
          "narrative"
        ],
        "title": "ReportCreate"
      },
      "ReportEdit": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Title"
          },
          "period": {
            "type": "string",
            "pattern": "^FY20\\d{2}/\\d{2} Q[1-4]$",
            "title": "Period"
          },
          "narrative": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Narrative"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "period",
          "narrative",
          "version"
        ],
        "title": "ReportEdit"
      },
      "ReportOut": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Title"
          },
          "period": {
            "type": "string",
            "pattern": "^FY20\\d{2}/\\d{2} Q[1-4]$",
            "title": "Period"
          },
          "narrative": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 20,
            "title": "Narrative"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "institution_id": {
            "type": "string",
            "format": "uuid",
            "title": "Institution Id"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "AI_SUMMARISED",
              "UNDER_REVIEW",
              "RETURNED",
              "ACCEPTED"
            ],
            "title": "State"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "is_simulated": {
            "type": "boolean",
            "title": "Is Simulated"
          },
          "review_comment": {
            "type": "string",
            "title": "Review Comment"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "period",
          "narrative",
          "id",
          "institution_id",
          "actor_id",
          "state",
          "version",
          "is_simulated",
          "review_comment",
          "created_at",
          "updated_at"
        ],
        "title": "ReportOut"
      },
      "Role": {
        "type": "string",
        "enum": [
          "CONVENER",
          "SECRETARIAT",
          "MDA_OFFICER",
          "FIELD_MONITOR",
          "ANCHOR_ENTITY",
          "OVERSIGHT"
        ],
        "title": "Role"
      },
      "Transition": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "submit",
              "review",
              "accept",
              "return"
            ],
            "title": "Action"
          },
          "comment": {
            "type": "string",
            "maxLength": 4000,
            "title": "Comment",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "action"
        ],
        "title": "Transition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
